---
import Sidebar from "../components/Sidebar.astro";
import elleCss from "../assets/css/elle.css?inline";
import lucaCss from "../assets/css/luca.css?inline";
import styleCss from "../assets/css/style.scss?inline";

interface Props {
	variant?: "elle" | "luca";
	title?: string;
}

const { variant = "elle", title } = Astro.props;
const isLuca = variant === "luca";

const slug = Astro.url.pathname.split("/").filter(Boolean).pop() || "index";
const displayTitle = `${isLuca ? "luca sīlot:" : "elle gamble:"} ${title || slug}`;
const unixTime = Math.floor(Date.now() / 1000).toString();

const css = (isLuca ? lucaCss : elleCss) + styleCss;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Fragment set:html={`<style>${css}</style>`} />
    <link
      rel="shortcut icon"
      href={`/assets/img/${isLuca ? "companionship.svg" : "lambda.svg"}`}
      type="image/x-icon"
    />
    <title>{displayTitle}</title>
  </head>
  <body>
    <container>
      <Sidebar variant={variant} unixTime={unixTime} />
      <main>
        <slot />
      </main>
    </container>
  </body>
</html>
